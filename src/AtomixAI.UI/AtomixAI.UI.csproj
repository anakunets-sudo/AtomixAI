<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Для работы с Revit UI элементами, если понадобятся -->
    <UseWPF>true</UseWPF>
    <Configurations>Debug2019;Release2019;Debug2026;Release2026;Debug2027;Release2027</Configurations>
  </PropertyGroup>

  <!-- Общие зависимости -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Специфичные зависимости для Revit 2025/2026 (.NET 8) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows' OR '$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Здесь можно добавить ссылку на Revit API 2025/2026 через NuGet -->
  </ItemGroup>

  <!-- Специфичные зависимости для Revit 2019 (.NET 4.8) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Используем стабильную версию для старого .NET -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
    <!-- Здесь можно добавить ссылку на Revit API 2019 через NuGet -->
  </ItemGroup>
  
   <!-- Копирование контента -->
  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AtomixAI.Core\AtomixAI.Core.csproj" />
  </ItemGroup>
  
</Project>
